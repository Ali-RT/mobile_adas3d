{
  "revision": "PARKING-LIDAR-DEPTH-2026-10-27-r1",
  "dataset": "nuScenes v1.0-mini",
  "split": "mini_val",
  "scenes": ["scene-0103", "scene-0916"],
  "maximum_images": 64,
  "selection_seed": "parking_depth_raw_v1",
  "selection": "GT-only round-robin class/range coverage then hashed fill; at most one camera image per keyframe",
  "camera_channels": ["CAM_FRONT", "CAM_FRONT_LEFT", "CAM_FRONT_RIGHT", "CAM_BACK", "CAM_BACK_LEFT", "CAM_BACK_RIGHT"],
  "max_camera_lidar_timestamp_difference_ms": 50,
  "max_ego_translation_between_sensor_poses_for_static_subset_m": 0.05,
  "depth_min_m": 2,
  "depth_max_m": 80,
  "range_bands_m": [[2,3],[3,4],[4,5],[5,6],[6,10],[10,20],[20,40],[40,80]],
  "primary_parking_band_m": [2,6],
  "quantization": "nearest integer image pixel; nearest camera-z LiDAR return wins duplicate pixels",
  "gt_boundary_guard": {"window_pixels": 5, "maximum_local_depth_span_m": 0.5},
  "invalid_semantic_indices": [0,31],
  "classes": {
    "Vehicle": ["vehicle.car", "vehicle.truck", "vehicle.bus.bendy", "vehicle.bus.rigid", "vehicle.trailer", "vehicle.construction", "vehicle.emergency.ambulance", "vehicle.emergency.police"],
    "Pedestrian": ["human.pedestrian.adult", "human.pedestrian.child", "human.pedestrian.construction_worker", "human.pedestrian.police_officer"]
  },
  "excluded_related_classes": ["vehicle.bicycle", "vehicle.motorcycle", "human.pedestrian.stroller", "human.pedestrian.wheelchair", "human.pedestrian.personal_mobility"],
  "static_attributes": ["vehicle.parked", "vehicle.stopped", "pedestrian.standing", "pedestrian.sitting_lying_down"],
  "minimum_valid_points_for_selection_cell": 5,
  "minimum_points_for_descriptive_cell": 100,
  "minimum_images_for_descriptive_cell": 5,
  "prediction_fields": ["yolo26n_depth", "depth_anything_v2_metric_outdoor_small"],
  "reference_field": "projected_lidar_camera_z_m",
  "metrics": ["mean_absolute_error_m", "median_absolute_error_m", "p95_absolute_error_m", "mean_signed_error_m", "fraction_within_0.10m", "fraction_within_0.20m", "rmse_m", "abs_rel", "delta1"],
  "per_image_scale_alignment": false,
  "depth_interpolation_into_unmeasured_gt_pixels": false,
  "same_valid_points_for_both_models": true,
  "detection_map_or_recall_evaluated": false,
  "training_or_calibration_fitting_authorized": false,
  "benchmark_scope": "Small enriched sparse-LiDAR engineering screen, not an official nuScenes benchmark or 10cm metrology qualification",
  "training_overlap_with_pretrained_models": "Unknown; record rather than claim a fully unseen dataset"
}
