+class TimmMobileNetV4Backbone(nn.Module):
+    """MobileNetV4 multi-scale feature extractor for MonoDETR."""
+
+    def __init__(self, cfg, train_backbone: bool, return_interm_layers: bool):
+        super().__init__()
+        if cfg.get('dilation', False):
+            raise ValueError('MobileNetV4 backbone does not support dilation')
+        out_indices = tuple(cfg.get('backbone_out_indices', [2, 3, 4]))
+        if not return_interm_layers:
+            out_indices = (out_indices[-1],)
+        self.body = timm.create_model(
+            cfg['backbone'],
+            pretrained=bool(cfg.get('backbone_pretrained', True)) and is_main_process(),
+            features_only=True,
+            out_indices=out_indices,
+        )
+        self.strides = list(self.body.feature_info.reduction())
+        self.num_channels = list(self.body.feature_info.channels())
+        expected_strides = [8, 16, 32] if return_interm_layers else [32]
+        if self.strides != expected_strides:
+            raise RuntimeError(
+                f'Expected MobileNetV4 strides {expected_strides}, got {self.strides}'
+            )
+        for name, parameter in self.body.named_parameters():
+            trainable_stage = name.startswith(('blocks.2.', 'blocks.3.', 'blocks.4.'))
+            parameter.requires_grad_(bool(train_backbone and trainable_stage))
+
+    def forward(self, images):
+        features = self.body(images)
+        out = OrderedDict()
+        for index, feature in enumerate(features):
+            mask = torch.zeros(
+                feature.shape[0], feature.shape[2], feature.shape[3],
+                dtype=torch.bool, device=feature.device,
+            )
+            out[str(index)] = NestedTensor(feature, mask)
+        return out
+
+
