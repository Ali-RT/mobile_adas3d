 from .ops.modules import MSDeformAttn, MSDeformAttn_cross, MultiheadAttention
 
+def coreml_multi_head_attention(module, query, key, value, heads, head_dim):
+    """Fixed-batch native attention equivalent used only for Core ML export."""
+    embed_dim = heads * head_dim
+    weight = module.in_proj_weight
+    bias = module.in_proj_bias
+    q = F.linear(query, weight[:embed_dim], bias[:embed_dim])
+    k = F.linear(key, weight[embed_dim:2 * embed_dim], bias[embed_dim:2 * embed_dim])
+    v = F.linear(value, weight[2 * embed_dim:], bias[2 * embed_dim:])
+    q = q.reshape(-1, 1, heads, head_dim).permute(1, 2, 0, 3)
+    k = k.reshape(-1, 1, heads, head_dim).permute(1, 2, 3, 0)
+    v = v.reshape(-1, 1, heads, head_dim).permute(1, 2, 0, 3)
+    weights = F.softmax(torch.matmul(q, k) / (head_dim ** 0.5), dim=-1)
+    output = torch.matmul(weights, v).permute(2, 0, 1, 3)
+    output = output.reshape(-1, 1, embed_dim)
+    return module.out_proj(output)
+
 
