@@ -66,6 +66,27 @@ def _is_power_of_2(n):
     return (n & (n-1) == 0) and n != 0
 
+def ms_deform_attn_core_coreml(value, sampling_locations, attention_weights,
+                               spatial_shapes, heads, channels, points):
+    """Rank-five native PyTorch implementation for fixed-shape Core ML export."""
+    split_sizes = [height * width for height, width in spatial_shapes]
+    values = value.split(split_sizes, dim=1)
+    sampling_grids = 2 * sampling_locations - 1
+    sampled = []
+    for level, (height, width) in enumerate(spatial_shapes):
+        value_level = values[level].flatten(2).transpose(1, 2).reshape(
+            heads, channels, height, width)
+        grid_level = sampling_grids[:, :, :, level * points:(level + 1) * points]
+        grid_level = grid_level.transpose(1, 2).flatten(0, 1)
+        sampled.append(F.grid_sample(value_level, grid_level, mode='bilinear',
+                                     padding_mode='zeros', align_corners=False))
+    weights = attention_weights.transpose(1, 2).reshape(
+        heads, 1, -1, len(spatial_shapes) * points)
+    output = (torch.stack(sampled, dim=-2).flatten(-2) * weights).sum(-1)
+    output = output.view(1, heads * channels, -1)
+    return output.transpose(1, 2).contiguous()
+
 
